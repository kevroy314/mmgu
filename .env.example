# Hallkeeper configuration. Copy to .env and fill in. Never commit .env.
# Everything a leader can change in the web app (channels, add-ons, permissions) is NOT here.

# ---- The hall ---------------------------------------------------------------
MMGU_GUILD_NAME=Your Guild
MMGU_APP_NAME=Hallkeeper
# The URL people use to reach the web hall (used in Discord links and OAuth redirects).
MMGU_BASE_URL=http://localhost:8420
# Long random string. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
MMGU_SECRET_KEY=
MMGU_GAME_PACK=monsters-and-memories

# ---- Who can log in ---------------------------------------------------------
# discord  = "Log in with Discord" (recommended for guilds)
# header   = a sign-in gateway in front of the hall (oauth2-proxy, Cloudflare Access, Google IAP)
# dev      = pick any name; ONLY for local testing
MMGU_AUTH_MODES=discord
# Made Leader on first login. Comma-separated: discord:<your Discord user id>, or email:<address> for header mode.
MMGU_BOOTSTRAP_LEADERS=
# Rank for everyone else on first login: guest, recruit, member
MMGU_DEFAULT_ROLE=recruit
# header mode only: the gateway must send this value in X-MMGU-Proxy-Secret
MMGU_PROXY_SECRET=
MMGU_PROXY_EMAIL_HEADER=X-Email
MMGU_DEV_LOGIN=false

# ---- Discord ----------------------------------------------------------------
# From https://discord.com/developers/applications → your app.
MMGU_DISCORD_TOKEN=
MMGU_DISCORD_CLIENT_ID=
MMGU_DISCORD_CLIENT_SECRET=
# Your guild's Discord server id (right-click the server → Copy Server ID)
MMGU_DISCORD_GUILD_ID=
# Map Discord roles to hall ranks/duties: <role id>=<leader|officer|member|recruit|banker|crafter|streamer|raidlead>
MMGU_DISCORD_ROLE_MAP=

# ---- Networking -------------------------------------------------------------
# Which host address the hall's port is published on. 127.0.0.1 = this machine only.
MMGU_BIND=127.0.0.1
MMGU_HOST_PORT=8420

# ---- Local AI (docker compose --profile ai) ---------------------------------
MMGU_OLLAMA_URL=http://ollama:11434
MMGU_OLLAMA_MODEL=qwen3-vl:8b

# ---- Optional: Claude for screenshot reading (Screenshot Reader add-on) ------
ANTHROPIC_API_KEY=

# ---- Optional: Tailscale Funnel (docker compose --profile share) ------------
TS_AUTHKEY=
TS_HOSTNAME=hallkeeper

# ---- Optional: backups (docker compose --profile backup) --------------------
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ---- Optional: Postgres instead of SQLite (e.g. Cloud SQL on GCP) ------------
# MMGU_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/hallkeeper
